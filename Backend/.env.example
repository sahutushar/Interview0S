PORT=8000
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama3-70b-8192
DB_PATH=./interviewos.db
AI_DAILY_LIMIT=20

# Lock CORS to your frontend origin in production (e.g. https://your-app.onrender.com).
# Defaults to "*" (all origins) when not set, which is fine for local dev but
# should always be set on any public deployment.
ALLOWED_ORIGIN=http://localhost:3000

# Optional but strongly recommended: raises GitHub API rate limit from 60/hr
# to 5,000/hr. Create a token at https://github.com/settings/tokens
# (no scopes needed for public repos).
GITHUB_TOKEN=
